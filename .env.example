# Lifeline Nexus — Environment Variable Template
# Copy this file to .env and fill in your actual keys.
# NEVER commit the real .env file — it is gitignored.

# Google Maps SDK key (restrict to Maps SDK for Android + iOS in Cloud Console)
GOOGLE_MAPS_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Google AI Studio / Gemini key (restrict to Generative Language API in Cloud Console)
# NOTE: This MUST be a different key from GOOGLE_MAPS_KEY (principle of least privilege).
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
